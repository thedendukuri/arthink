# ── ārthink. environment variables ──────────────────────────
# Copy this file to .env and fill in your values.
# .env is never committed to GitHub (see .gitignore).

# Port the server listens on locally (Railway sets this automatically)
PORT=3000

# ── Schwab Developer API ──────────────────────────────────────
# Found in: https://developer.schwab.com → your app → App Key / App Secret
# After filling these in, run `python schwab_refresh.py` once to do the
# interactive OAuth flow — it saves schwab_tokens.json. After that,
# server.js auto-refreshes the access token in the background.
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
# Callback URL must match what you registered in the developer portal
SCHWAB_CALLBACK=https://127.0.0.1:8182

# ── Supabase (add these after creating your Supabase project) ─
# Found in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
